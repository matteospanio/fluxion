/target
# Standalone crates (fluxion-py) build into their own nested target/ dirs.
**/target/
**/*.rs.bk
Cargo.lock.bak

# Python bindings build artifacts (added when fluxion-py lands)
__pycache__/
*.so
*.pyd
.venv/
dist/
*.egg-info/

# WASM build artifacts (scripts/build-wasm.sh output; the JS package that wraps it is
# committed, the compiled bytes are not)
/pkg
crates/fluxion-wasm/js/pkg/
# The wasm-vs-native reference is regenerated by `cargo test --test parity --ignored
# write_reference` on every run, not committed — see crates/fluxion-wasm/tests/parity.rs.
crates/fluxion-wasm/js/reference.json
# Browser downloaded by @puppeteer/browsers for the AudioWorklet test.
crates/fluxion-wasm/js/chrome/
node_modules/

# Editor / OS
.DS_Store
.idea/
.vscode/
