{
  "name": "fluxion",
  "version": "0.2.0",
  "description": "Differentiable, cross-vendor audio DSP in the browser \u2014 the same engine as the Rust library, the CLI and the Python package.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./ops": {
      "types": "./ops.d.ts",
      "default": "./ops.js"
    },
    "./worklet": {
      "default": "./worklet-loader.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "ops.js",
    "ops.d.ts",
    "pkg/fluxion_wasm.js",
    "pkg/fluxion_wasm.d.ts",
    "pkg/fluxion_wasm_bg.wasm",
    "pkg/fluxion_wasm_bg.wasm.d.ts",
    "README.md",
    "worklet-loader.mjs",
    "fluxion-worklet.js",
    "worklet-textcodec.js",
    "pkg/no-modules/fluxion_wasm.js"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matteospanio/fluxion.git",
    "directory": "crates/fluxion-wasm/js"
  },
  "homepage": "https://github.com/matteospanio/fluxion",
  "keywords": [
    "audio",
    "dsp",
    "wasm",
    "webassembly",
    "filter",
    "realtime"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "../../../scripts/build-wasm.sh",
    "test": "cargo test -p fluxion-wasm --test parity -- --ignored write_reference && node smoke.mjs && node parity.mjs && node worklet.test.mjs && node budget.test.mjs && node quickstart.mjs",
    "test:browser": "node browser.test.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.4.0"
  }
}
